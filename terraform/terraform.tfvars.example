# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region       = "ap-south-1"
cluster_name = "ecom"

node_instance_type = "m7i-flex.large"

node_group_size = {
  desired = 2
  min     = 2
  max     = 4
}

# One NAT gateway rather than one per AZ. Saves roughly $32/month and makes a
# single AZ a shared dependency for outbound traffic from every node.
single_nat_gateway = true

# Open, which is what the AWS console and a laptop on a changing IP need.
# Narrow it once this is more than a demo:
#   cluster_endpoint_public_access_cidrs = ["203.0.113.4/32"]
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

tags = {
  Project   = "ecom"
  ManagedBy = "terraform"
  Owner     = "CHANGE_ME"
}
