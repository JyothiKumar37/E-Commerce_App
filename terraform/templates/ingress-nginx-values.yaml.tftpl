# Rendered by terraform/platform.tf. Edit the template, not the release.
#
# TLS terminates at the NLB using an ACM certificate. An ACM certificate has no
# exportable private key — only an AWS load balancer can use it, never a process
# in a pod — so there is nothing a Kubernetes TLS secret could hold, and the
# Ingress objects in k8s/ carry no `tls:` block.
controller:
  replicaCount: ${replica_count}

  service:
    type: LoadBalancer

    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: nlb
      service.beta.kubernetes.io/aws-load-balancer-backend-protocol: http
      service.beta.kubernetes.io/aws-load-balancer-ssl-ports: https
      service.beta.kubernetes.io/aws-load-balancer-ssl-cert: ${certificate_arn}

    # Both mappings are counter-intuitive and both are load-bearing.
    #
    #   https -> http     Port 443 is already decrypted by the time it reaches a
    #                     pod, so it must arrive at nginx's PLAINTEXT port.
    #                     Sending it to nginx's 443 makes nginx attempt a TLS
    #                     handshake on cleartext and every request fails.
    #
    #   http  -> tohttps  Port 80 goes to a listener whose only job is the
    #                     redirect defined in http-snippet below.
    targetPorts:
      http: tohttps
      https: http

  containerPort:
    http: 80
    https: 443
    tohttps: 2443

  config:
    # nginx sees every request as HTTP, including the ones the NLB decrypted, so
    # it cannot tell an HTTPS visitor from an HTTP one. The built-in redirect
    # would send HTTPS visitors to HTTPS for ever — a loop that only appears
    # once a certificate is attached.
    ssl-redirect: "false"

    # The redirect lives here rather than in an Ingress annotation because
    # ingress-nginx disables snippet annotations by default. Chart values are
    # administrator-supplied, so this path stays open.
    http-snippet: |
      server {
        listen 2443;
        return 308 https://$host$request_uri;
      }

  # Two replicas on different nodes: a single-replica ingress controller means
  # every request in flight fails while it restarts, and it restarts on every
  # node drain.
  affinity:
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            topologyKey: kubernetes.io/hostname
            labelSelector:
              matchLabels:
                app.kubernetes.io/name: ingress-nginx
                app.kubernetes.io/component: controller

  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi
