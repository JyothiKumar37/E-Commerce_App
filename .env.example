# Copy to .env before running `docker compose up`.
#
# Generate both secrets — they must be different, and at least 32 characters:
#   openssl rand -base64 48

# ---- required secrets -------------------------------------------------
# Signs browser-facing access tokens.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_aaaaaaaaaaaaaaaa
# Signs gateway -> service tokens. Never share this with a client.
INTERNAL_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48_bbbbbbbbbbbb

POSTGRES_PASSWORD=ecom_dev_password

# ---- runtime ----------------------------------------------------------
# Setting this to `production` turns on strict config guards: CORS_ORIGINS may
# no longer be localhost or "*", PGSSLMODE may no longer be `disable`, and the
# payment service refuses to start on the mock provider. Compose is a local
# development stack, so it stays `development`.
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated allowlist. Must name the storefront origin exactly: the
# refresh cookie is httpOnly + credentialed, which a wildcard origin forbids.
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# ---- auth -------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# Use "none" (with COOKIE_SECURE=true) if the API is on a different site.
COOKIE_SAMESITE=lax
# Path the refresh cookie is scoped to. Must match the path the BROWSER sees:
# behind a reverse proxy serving the API at /api, this has to be /api/auth.
# docker-compose.prod.yml sets it for you.
# COOKIE_PATH=/auth

# ---- commerce ---------------------------------------------------------
TAX_RATE=0.19
RESERVATION_TTL_SECONDS=900
REQUIRE_VERIFIED_PURCHASE=false

# Fraction of mock card payments that are declined, for exercising the
# failure path. 0 = always approve.
MOCK_DECLINE_RATE=0

# The mock provider approves payments without taking money, so the payment
# service refuses to start with NODE_ENV=production. Set this only for a
# staging environment that deliberately runs a fake PSP.
# ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# ---- search -----------------------------------------------------------
INDEXER_INTERVAL_MS=5000

# ---- recommendations --------------------------------------------------
RECO_RUN_ON_SCHEDULE=true
RECO_RUN_ON_BOOT=false

# ---- deployment -------------------------------------------------------
# Uncomment this whole block for a server deployment.
#
# NODE_ENV=production is not optional even for a demo: the gateway refuses to
# start with a public PUBLIC_URL while in development mode, because that serves
# real traffic with the CORS, database-TLS and mock-payment guards disabled.
# "Development purpose" is about who uses it, not which runtime mode is safe.
#
# NODE_ENV=production
# WEB_TARGET=production
# WEB_PUBLISH=80:80                       # nginx serves the storefront on :80
# PUBLIC_URL=http://13.51.42.7            # your EC2 IP, scheme included
# VITE_API_URL=http://13.51.42.7/api      # baked into the bundle at build time
# COOKIE_SECURE=false                     # browsers drop Secure cookies on HTTP
# COOKIE_PATH=/api/auth                   # matches nginx's /api prefix
# ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=true  # the bundled PSP does not take money
# ALLOW_SEED=yes                          # load demo products

# ---- web build target -------------------------------------------------
# "development" for hot reload, "production" for an nginx-served build.
WEB_TARGET=development
