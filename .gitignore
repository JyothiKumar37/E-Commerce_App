node_modules/
dist/
build/
coverage/
.nyc_output/

# Secrets — .env.example is the template that IS committed.
.env
.env.local
.env.*.local
*.pem
*.key

# A Kubernetes Secret is base64, not encryption. This file holds the real
# JWT signing keys and the Postgres password in readable form, so it is
# generated per cluster and never committed. k8s/ecom-secrets.example.yaml
# is the template.
k8s/ecom-secrets.yaml

logs/
*.log
npm-debug.log*
.npm/

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local editor/agent state. Machine-specific, not part of the project.
.claude/

.cache/
.vite/
*.tsbuildinfo

# Terraform. State can contain secrets in plain text — database passwords,
# certificate details, anything a resource returns — so it is never committed.
# tfvars carries per-environment values including the domain and owner tags.
terraform/.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# versions and checksums, so a colleague or a CI runner resolves the same
# providers rather than whatever the version constraints allow today.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
